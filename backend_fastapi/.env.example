# Database connection (from db_connection.txt in database_postgresql container)
# DATABASE_URL=postgresql://appuser:dbuser123@localhost:5000/myapp
DATABASE_URL=postgresql://appuser:dbuser123@localhost:5000/myapp

# JWT Settings
# JWT_SECRET_KEY - A secure random string used for signing JWT tokens
JWT_SECRET_KEY=change-me-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server
PORT=3001
HOST=0.0.0.0
UVICORN_HOST=0.0.0.0
UVICORN_WORKERS=1

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000
FRONTEND_URL=http://localhost:3000
SITE_URL=http://localhost:3000
