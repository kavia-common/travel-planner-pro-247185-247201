# ============================================================
# Travel Planner Pro — Backend FastAPI Environment Variables
# ============================================================
# Copy this file to .env and fill in the actual values.
# Do NOT commit .env to version control.
# ============================================================

# --- Database ---
# PostgreSQL connection URL. Constructed from individual vars or set directly.
# Required env vars from database_postgresql container:
#   POSTGRES_URL, POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB, POSTGRES_PORT
# The application reads DATABASE_URL; build it from the above if needed:
#   DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@<host>:<POSTGRES_PORT>/<POSTGRES_DB>
DATABASE_URL=postgresql://appuser:dbuser123@localhost:5000/myapp

# --- JWT Authentication ---
# JWT_SECRET_KEY — A secure random string used for signing JWT tokens (REQUIRED)
JWT_SECRET_KEY=change-me-to-a-secure-random-string
# JWT_ALGORITHM — Algorithm for JWT encoding (default: HS256)
JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES — Token lifetime in minutes (default: 1440 = 24h)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Server ---
# PORT — Port the uvicorn server listens on
PORT=3001
# HOST / UVICORN_HOST — Bind address
HOST=0.0.0.0
UVICORN_HOST=0.0.0.0
# UVICORN_WORKERS — Number of uvicorn worker processes
UVICORN_WORKERS=1

# --- CORS ---
# ALLOWED_ORIGINS — Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000
# FRONTEND_URL — Primary frontend URL (also added to CORS origins if not present)
FRONTEND_URL=http://localhost:3000
# SITE_URL — The canonical site URL (used for redirects, emails, etc.)
SITE_URL=http://localhost:3000
# ALLOWED_METHODS — Comma-separated HTTP methods (default: GET,POST,PUT,DELETE,PATCH,OPTIONS)
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
# ALLOWED_HEADERS — Comma-separated headers (note: code uses allow_headers=["*"] for safety)
ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
# CORS_MAX_AGE — Max age for CORS preflight cache (seconds)
CORS_MAX_AGE=3600

# --- WebSocket ---
# WS_URL — WebSocket base URL for real-time notifications
WS_URL=ws://localhost:3001/ws

# --- Deployment ---
# BACKEND_URL — Public URL of this backend (used for self-referencing)
BACKEND_URL=http://localhost:3001
# COOKIE_DOMAIN — Domain for cookies (if applicable)
# COOKIE_DOMAIN=localhost
# TRUST_PROXY — Set to true behind a reverse proxy
# TRUST_PROXY=false

# --- Misc ---
# NODE_ENV — Environment mode (development, production)
# NODE_ENV=development
# REQUEST_TIMEOUT_MS — HTTP request timeout
# REQUEST_TIMEOUT_MS=30000
# RATE_LIMIT_WINDOW_S — Rate limiting window in seconds
# RATE_LIMIT_WINDOW_S=60
# RATE_LIMIT_MAX — Max requests per rate limit window
# RATE_LIMIT_MAX=100
